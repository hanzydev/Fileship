# Most values below are only defaults: super admins can override them from Administration → Instance.
# DATABASE_URL, NUXT_DATA_DIRECTORY, the updater, the telemetry URL and the build-time options can only be set here.

# [required] PostgreSQL connection string.
DATABASE_URL=

# [optional] Directory for local storage, thumbnails and temporary files. (default: ./data)
NUXT_DATA_DIRECTORY=

# [optional] Name shown in the browser title, embeds and the dashboard. (default: Fileship)
NUXT_PUBLIC_SITE_NAME=

# [optional] How the dashboard reaches the updater agent. docker-compose.yml sets both. (default: http://updater-agent:3001)
NUXT_UPDATER_URL=
NUXT_UPDATER_SECRET=

# [optional, build time] Cron-based schedule for generating the statistics. See https://crontab.guru/ for syntax. (Default: '*/30 * * * *' - every 30 minutes)"
GENERATE_STATS_CRON=

# [optional, build time] Cron-based schedule for deleting expired files and links. See https://crontab.guru/ for syntax. (Default: '*/5 * * * *' - every 5 minutes)"
DELETE_EXPIRED_CRON=

# [optional] The maximum size of the user avatars, in MB. (default: 4)
NUXT_AVATAR_MAX_SIZE=

# [optional] The log level (0, 1, 2) (default: 2)
NUXT_LOG_LEVEL=

# [optional] Whether to delete Exif data. (default: true)
NUXT_REMOVE_EXIF_DATA=

# [optional] Days deleted files, folders and notes stay in the trash. 0 deletes them immediately. (default: 30)
NUXT_TRASH_RETENTION_DAYS=

# [optional] Whether users can schedule automatic backups. (default: true)
NUXT_SCHEDULED_BACKUPS_ENABLED=

# [optional] The size per chunk of the files to be uploaded, in MB, at least 5. (default: 25)
NUXT_PUBLIC_FILE_CHUNK_SIZE=

# [optional] Whether to return https url in uploads. (default: auto)
NUXT_PUBLIC_RETURN_HTTPS=

# [optional] Cloudflare Turnstile configuration.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# [optional] Address of the dashboard, used for the links in emails and single sign-on, for example https://files.example.com. Email stays off until it, the SMTP host and the sender address are set.
NUXT_SITE_URL=

# [optional] SMTP server for emails: host, port, security (starttls, tls or none), username, password and sender address. (default: none, 587, starttls)
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_SECURITY=
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=

# [optional] Allow anyone to create an account from the login page. (default: false)
NUXT_PUBLIC_REGISTRATION_ENABLED=

# [optional] Comma-separated permissions given to self-registered users: UploadFiles, TakeNotes, ShortenLinks. Admin is never granted. (default: UploadFiles,TakeNotes,ShortenLinks)
NUXT_REGISTRATION_PERMISSIONS=

# [optional] Storage limit for self-registered users, in MB. -1 means unlimited. (default: -1)
NUXT_REGISTRATION_USABLE_SPACE=

# [optional] Single sign-on with OpenID Connect: enabled, issuer URL, client id, client secret, login button label and whether people without an account get one with the registration permissions and storage limit. Needs NUXT_SITE_URL. (default: false, none, none, none, none, false)
NUXT_OIDC_ENABLED=
NUXT_OIDC_ISSUER_URL=
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
NUXT_OIDC_BUTTON_LABEL=
NUXT_OIDC_AUTO_REGISTER=

# [optional] Allow logging in with a password or passkey while single sign-on is on. Super admins always can. (default: true)
NUXT_PASSWORD_LOGIN_ENABLED=

# [optional, build time] Enable Progressive Web App support. (default: true)
ENABLE_PWA=

# [optional] Enable anonymous data collection. (default: true)
NUXT_TELEMETRY_ENABLED=

# [optional] Where telemetry reports are sent. Development builds only send them when this is set. (default: https://fileship-telemetry.hanzy.dev)
NUXT_TELEMETRY_URL=

# [optional] AI settings: enabled, preset (low, medium, high), parallel jobs, threads per job, job heartbeat timeout in ms. (default: true, medium, 1, 2, 120000)
NUXT_PUBLIC_AI_ENABLED=
NUXT_AI_PRESET=
NUXT_AI_QUEUE_CONCURRENCY=
NUXT_AI_INFERENCE_THREADS=
NUXT_AI_JOB_LEASE_MS=
