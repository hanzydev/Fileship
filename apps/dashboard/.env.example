# [required] PostgreSQL connection string.
DATABASE_URL=

# [optional] Directory for the uploaded files. (default: ./data)
NUXT_DATA_DIRECTORY=

# [optional, build time] Cron-based schedule for generating the statistics. See https://crontab.guru/ for syntax. (Default: '*/30 * * * *' - every 30 minutes)"
GENERATE_STATS_CRON=

# [optional, build time] Cron-based schedule for deleting expired files. See https://crontab.guru/ for syntax. (Default: '*/5 * * * *' - every 5 minutes)"
DELETE_EXPIRED_CRON=

# [optional] The maximum size of the user avatars, in MB. (default: 4)
NUXT_AVATAR_MAX_SIZE=

# [optional] The log level (0, 1, 2) (default: 2)
NUXT_LOG_LEVEL=

# [optional] Whether to delete Exif data. (default: true)
NUXT_REMOVE_EXIF_DATA=

# [optional] The size per chunk of the files to be uploaded, in MB. (default: 25)
NUXT_PUBLIC_FILE_CHUNK_SIZE=

# [optional] Whether to return https url in uploads. (default: auto)
NUXT_PUBLIC_RETURN_HTTPS=

# [optional] Cloudflare Turnstile configuration.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# [optional] Allow anyone to create an account from the login page. (default: false)
NUXT_PUBLIC_REGISTRATION_ENABLED=

# [optional] Comma-separated permissions given to self-registered users: UploadFiles, TakeNotes. Admin is never granted. (default: UploadFiles,TakeNotes)
NUXT_REGISTRATION_PERMISSIONS=

# [optional] Storage limit for self-registered users, in MB. -1 means unlimited. (default: -1)
NUXT_REGISTRATION_USABLE_SPACE=

# [optional, build time] Enable Progressive Web App support. (default: true)
ENABLE_PWA=

# [optional] Enable anonymous data collection. (default: true)
NUXT_TELEMETRY_ENABLED=

# [optional] AI settings (default: true, 1, 2, 24, 10, 900000, 5)
NUXT_PUBLIC_AI_ENABLED=
NUXT_AI_QUEUE_CONCURRENCY=
NUXT_AI_INFERENCE_THREADS=
NUXT_AI_VIDEO_MAX_FRAMES=
NUXT_AI_VIDEO_SAMPLE_INTERVAL_SECONDS=
NUXT_AI_JOB_LEASE_MS=
NUXT_AI_JOB_DEQUEUE_RETRIES=
