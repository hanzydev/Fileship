generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserPermission {
  Admin
  UploadFiles
  TakeNotes
  ShortenLinks
}

enum BackupRestoreState {
  Extracting
  DeletingPreviousData
  RestoringData
}

enum AIJobType {
  AnalyzeImage
  AnalyzeVideo
  AnalyzeText
  DetectPII
}

enum StorageType {
  S3
  SFTP
  FTP
}

enum FolderRole {
  Viewer
  Editor
}

enum EmailTokenType {
  VerifyEmail
  ResetPassword
}

enum AIJobStatus {
  Pending
  Processing
  Completed
  Failed
}

enum BackupFrequency {
  Off
  Daily
  Weekly
}

enum BackupRunStatus {
  Created
  LimitReached
  Failed
}

model User {
  id                     String              @id @unique @default(uuid())
  username               String              @unique
  password               String
  avatar                 String?
  permissions            UserPermission[]
  files                  File[]
  views                  View[]
  notes                  Note[]
  folders                Folder[]
  sessions               Session[]
  logs                   Log[]
  totpEnabled            Boolean             @default(false)
  totpSecret             String?
  uploadTokenHash        String?             @unique
  uploadTokenEncrypted   String?
  superAdmin             Boolean             @default(false)
  limits                 Json                @default("{}")
  embed                  Json                @default("{}")
  aiSettings             Json                @default("{}")
  createdAt              DateTime            @default(now())
  domains                String[]
  backupRestoreState     BackupRestoreState?
  backupRestoreStartedAt DateTime?
  theme                  String              @default("Fileship")
  language               String?
  email                  String?             @unique
  pendingEmail           String?
  storageWarnedAt        DateTime?
  emailTokens            EmailToken[]
  invites                Invite[]
  credentials            Credential[]
  aiJobs                 AIJob[]
  inbox                  Inbox?
  backups                Backup[]
  backupSchedule         BackupSchedule?
  links                  Link[]
  folderMemberships      FolderMember[]
}

model EmailToken {
  id        String         @id @default(uuid())
  tokenHash String         @unique
  type      EmailTokenType
  email     String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

model Invite {
  id          String           @id @default(uuid())
  tokenHash   String           @unique
  email       String
  permissions UserPermission[]
  usableSpace Int
  invitedBy   User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([email])
}

model Credential {
  id         String   @id @unique
  name       String   @default("Untitled")
  publicKey  String
  counter    Int
  transports String[]
  backedUp   Boolean
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model File {
  id                 String    @id @unique @default(uuid())
  fileName           String    @unique
  name               String
  mimeType           String
  size               BigInt
  maxViews           Int       @default(0)
  expiresAt          DateTime?
  password           String?
  createdAt          DateTime  @default(now())
  author             User      @relation(fields: [authorId], references: [id])
  authorId           String
  folder             Folder?   @relation(fields: [folderId], references: [id])
  folderId           String?
  views              View[]
  embedding          Json?
  textEmbedding      Json?
  ocrText            String?
  caption            String?
  piiDetected        Boolean   @default(false)
  piiReasons         String[]  @default([])
  piiOverride        Boolean?
  embeddingModel     String?
  textEmbeddingModel String?
  aiAnalyzedAt       DateTime?
  metadata           Json?
  storage            Storage?  @relation(fields: [storageId], references: [id], onDelete: Restrict)
  storageId          String?
  deletedAt          DateTime?
  contentHash        String?

  aiJobs AIJob[]

  @@index([authorId, deletedAt])
  @@index([authorId, size])
  @@index([authorId, contentHash])
}

model Storage {
  id        String      @id @default(uuid())
  name      String
  type      StorageType
  config    String
  createdAt DateTime    @default(now())
  files     File[]
  backups   Backup[]
}

model Backup {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  size      BigInt
  storageId String?
  storage   Storage? @relation(fields: [storageId], references: [id], onDelete: Restrict)
  automatic Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model BackupSchedule {
  userId        String           @id
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  frequency     BackupFrequency
  hour          Int
  weekday       Int
  timezone      String
  keep          Int
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  lastRunStatus BackupRunStatus?

  @@index([nextRunAt])
}

model AIJob {
  id       String      @id @unique @default(uuid())
  type     AIJobType
  status   AIJobStatus @default(Pending)
  attempts Int         @default(0)
  error    String?

  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([fileId])
}

model Note {
  id        String    @id @unique @default(uuid())
  title     String
  content   String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  public    Boolean   @default(false)
  deletedAt DateTime?

  @@index([authorId, deletedAt])
}

model Folder {
  id        String    @id @unique @default(uuid())
  name      String
  public    Boolean
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  children  Folder[]  @relation("FolderTree")
  files     File[]
  inbox     Inbox?
  members   FolderMember[]
  deletedAt DateTime?

  @@index([authorId, deletedAt])
  @@index([parentId])
}

model FolderMember {
  id        String     @id @default(uuid())
  folder    Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      FolderRole @default(Viewer)
  createdAt DateTime   @default(now())

  @@unique([folderId, userId])
  @@index([userId])
}

model Log {
  id        String   @id @unique @default(uuid())
  action    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  message   String
  ip        String
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model View {
  id        String   @id @unique @default(uuid())
  ip        String
  createdAt DateTime @default(now())
  file      File?    @relation(fields: [fileId], references: [id])
  fileId    String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String?

  @@index([createdAt])
  @@index([ownerId])
}

model Session {
  id                    String    @id @unique @default(uuid())
  tokenHash             String    @unique
  ip                    String
  os                    String
  platform              String
  location              String
  userAgent             String    @default("")
  createdAt             DateTime  @default(now())
  lastSeen              DateTime  @default(now())
  lastVerify            DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  impersonator          Session?  @relation("Impersonation", fields: [impersonatorSessionId], references: [id], onDelete: Cascade)
  impersonatorSessionId String?
  impersonations        Session[] @relation("Impersonation")

  @@index([userId])
}

model Stat {
  id                String   @id @unique @default(uuid())
  users             Int
  storageUsed       BigInt
  storageUsedByUser Json
  views             Json
  viewsByUser       Json
  files             Int
  filesByUser       Json
  types             Json
  createdAt         DateTime @default(now())
}

model Inbox {
  id       String  @id @unique @default(uuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String  @unique
  folder   Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String  @unique
  slug     String? @unique
  enabled  Boolean @default(false)
  password String?
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Link {
  id        String    @id @default(uuid())
  code      String    @unique
  url       String
  password  String?
  maxClicks Int       @default(0)
  clicks    Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  @@index([authorId, createdAt])
}
