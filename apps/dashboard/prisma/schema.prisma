generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserPermission {
  Admin
  UploadFiles
  TakeNotes
}

enum BackupRestoreState {
  Extracting
  DeletingPreviousData
  RestoringData
}

enum AIJobType {
  GenerateClipEmbedding
  GenerateVideoEmbedding
  GenerateOcrText
  GenerateTextEmbedding
  GenerateImageCaption
  DetectPII
}

enum StorageType {
  S3
  SFTP
  FTP
}

enum AIJobStatus {
  Pending
  Processing
  Completed
  Failed
}

model User {
  id                     String              @id @unique @default(uuid())
  username               String              @unique
  password               String
  avatar                 String?
  permissions            UserPermission[]
  files                  File[]
  views                  View[]
  notes                  Note[]
  folders                Folder[]
  sessions               Session[]
  logs                   Log[]
  totpEnabled            Boolean             @default(false)
  totpSecret             String?
  uploadTokenHash        String?             @unique
  uploadTokenEncrypted   String?
  superAdmin             Boolean             @default(false)
  limits                 Json                @default("{}")
  embed                  Json                @default("{}")
  aiSettings             Json                @default("{}")
  createdAt              DateTime            @default(now())
  domains                String[]
  backupRestoreState     BackupRestoreState?
  backupRestoreStartedAt DateTime?
  theme                  String              @default("Fileship")
  credentials            Credential[]
  aiJobs                 AIJob[]
  inbox                  Inbox?
}

model Credential {
  id         String   @id @unique
  name       String   @default("Untitled")
  publicKey  String
  counter    Int
  transports String[]
  backedUp   Boolean
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model File {
  id            String    @id @unique @default(uuid())
  fileName      String    @unique
  mimeType      String
  size          BigInt
  maxViews      Int       @default(0)
  expiresAt     DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  folder        Folder?   @relation(fields: [folderId], references: [id])
  folderId      String?
  views         View[]
  embedding     Json?
  textEmbedding Json?
  ocrText       String?
  caption       String?
  piiDetected   Boolean   @default(false)
  piiReasons    String[]  @default([])
  metadata      Json?
  storage       Storage?  @relation(fields: [storageId], references: [id], onDelete: Restrict)
  storageId     String?

  aiJobs AIJob[]
}

model Storage {
  id        String      @id @default(uuid())
  name      String
  type      StorageType
  config    String
  createdAt DateTime    @default(now())
  files     File[]
}

model AIJob {
  id       String      @id @unique @default(uuid())
  type     AIJobType
  status   AIJobStatus @default(Pending)
  attempts Int         @default(0)
  error    String?

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([fileId])
}

model Note {
  id        String   @id @unique @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  public    Boolean  @default(false)
}

model Folder {
  id        String   @id @unique @default(uuid())
  name      String
  public    Boolean
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  files     File[]
  inbox     Inbox?
}

model Log {
  id        String   @id @unique @default(uuid())
  action    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  message   String
  ip        String
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model View {
  id        String   @id @unique @default(uuid())
  ip        String
  createdAt DateTime @default(now())
  file      File?    @relation(fields: [fileId], references: [id])
  fileId    String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String?

  @@index([createdAt])
  @@index([ownerId])
}

model Session {
  id                    String    @id @unique @default(uuid())
  tokenHash             String    @unique
  ip                    String
  os                    String
  platform              String
  location              String
  userAgent             String    @default("")
  createdAt             DateTime  @default(now())
  lastSeen              DateTime  @default(now())
  lastVerify            DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  impersonator          Session?  @relation("Impersonation", fields: [impersonatorSessionId], references: [id], onDelete: Cascade)
  impersonatorSessionId String?
  impersonations        Session[] @relation("Impersonation")

  @@index([userId])
}

model Stat {
  id                String   @id @unique @default(uuid())
  users             Int
  storageUsed       BigInt
  storageUsedByUser Json
  views             Json
  viewsByUser       Json
  files             Int
  filesByUser       Json
  types             Json
  createdAt         DateTime @default(now())
}

model Inbox {
  id       String  @id @unique @default(uuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String  @unique
  folder   Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String  @unique
  slug     String? @unique
  enabled  Boolean @default(false)
  password String?
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
