{
    "name": "dashboard",
    "type": "module",
    "scripts": {
        "build": "pnpm db:generate && nuxt build",
        "dev": "pnpm db:generate && pnpm db:deploy && nuxt dev",
        "preview": "pnpm db:deploy && node --env-file-if-exists=.env -r ./scripts/fixPrisma.js .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "cleanup": "nuxt cleanup",
        "lint:types": "nuxt typecheck",
        "lint:code": "eslint --fix .",
        "lint": "pnpm lint:code",
        "db:prototype": "prisma db push",
        "db:migrate": "prisma migrate dev --create-only",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate --no-hints",
        "db:deploy": "prisma migrate deploy",
        "db:reset": "prisma migrate reset"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/lib-storage": "^3.1149.0",
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@fileship/ai": "workspace:*",
        "@fileship/telemetry": "workspace:*",
        "@fileship/ui": "workspace:*",
        "@orama/orama": "^3.1.18",
        "@orama/stopwords": "^3.1.18",
        "@simplewebauthn/server": "^14.0.3",
        "@tanstack/vue-virtual": "^3.13.40",
        "@unovis/ts": "^1.7.1",
        "@unovis/vue": "^1.7.1",
        "argon2": "^0.45.1",
        "basic-ftp": "^6.2.3",
        "consola": "^3.4.2",
        "defu": "^6.1.7",
        "dotenv": "^18.0.7",
        "engine.io": "^6.6.11",
        "filesize": "^11.0.25",
        "fluent-ffmpeg": "^2.1.3",
        "h3": "^1.15.11",
        "mime": "^4.1.0",
        "nanoid": "^6.0.2",
        "ofetch": "^1.5.1",
        "otplib": "^13.5.0",
        "pathe": "^2.0.3",
        "sharp": "^0.35.5",
        "socket.io": "^4.8.4",
        "ssh2-sftp-client": "^12.1.1",
        "stream-chain": "^4.2.6",
        "stream-json": "^3.7.0",
        "tar": "^7.5.22",
        "uqr": "^0.1.3",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@nuxtjs/turnstile": "^1.1.3",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@simplewebauthn/browser": "^14.0.0",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/ssh2-sftp-client": "^9.0.6",
        "@types/stream-chain": "^2.1.0",
        "@types/stream-json": "^1.7.8",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vueuse/core": "^15.0.0",
        "bufferutil": "^4.1.0",
        "dayjs": "^1.11.23",
        "eslint": "^10.12.0",
        "highlight.js": "^11.12.0",
        "katex": "^0.18.11",
        "marked": "^18.1.0",
        "marked-katex-extension": "^5.1.13",
        "nuxt": "^4.6.1",
        "prisma": "^7.8.0",
        "scule": "^1.3.0",
        "socket.io-client": "^4.8.4",
        "typescript": "^6.0.3",
        "utf-8-validate": "^6.0.6",
        "vue-tsc": "^3.3.12"
    },
    "packageManager": "pnpm@11.9.0"
}
