{
    "name": "desktop",
    "productName": "Fileship",
    "description": "Capture, record and upload to your Fileship, and browse it from Explorer.",
    "version": "1.1.0",
    "author": "Hànzy <contact@hanzy.dev>",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "nuxt generate && tsdown && node scripts/native.mjs && node scripts/harbor.mjs",
        "package": "pnpm build && electron-builder --win",
        "postinstall": "nuxt prepare",
        "lint:types": "nuxt typecheck && tsc -p electron/tsconfig.json --noEmit",
        "lint:code": "eslint --fix .",
        "lint": "pnpm lint:code"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@fileship/ui": "workspace:*",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.7.1",
        "@vueuse/core": "^15.0.0",
        "electron": "^44.7.2",
        "electron-builder": "^26.15.3",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.9",
        "eslint": "^10.12.0",
        "filesize": "^11.0.25",
        "konva": "^10.8.0",
        "node-addon-api": "8.9.2",
        "node-api-headers": "1.9.0",
        "nuxt": "^4.6.1",
        "semver": "^7.8.5",
        "socket.io-client": "^4.8.4",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.12",
        "zod": "^4.6.5"
    }
}
