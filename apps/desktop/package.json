{
    "name": "desktop",
    "productName": "Fileship",
    "description": "Capture, record and upload to your Fileship, and browse it from Explorer.",
    "version": "1.1.1",
    "author": "Hànzy <contact@hanzy.dev>",
    "license": "MIT",
    "private": true,
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "nuxt generate && tsdown && node scripts/native-assets.mjs && node scripts/host-settings.mjs && node scripts/harbor.mjs && node scripts/host.mjs",
        "package": "pnpm build && electron-builder --win",
        "postinstall": "nuxt prepare",
        "lint:types": "nuxt typecheck && tsc -p electron/tsconfig.json --noEmit",
        "lint:code": "eslint --fix .",
        "lint": "pnpm lint:code"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@fileship/ui": "workspace:*",
        "@fontsource-variable/geist": "^5.3.0",
        "@types/node": "^26.6.5",
        "@vueuse/core": "^15.0.0",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "electron-log": "^5.4.4",
        "eslint": "^10.12.0",
        "filesize": "^11.0.25",
        "nuxt": "^4.6.2",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.13",
        "zod": "^4.6.7"
    }
}
