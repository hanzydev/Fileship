{
    "name": "extension",
    "description": "Upload files, screenshots and images to your Fileship and shorten links from Chrome, Edge and Firefox.",
    "version": "1.0.0",
    "author": "Hànzy <contact@hanzy.dev>",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build && wxt build -b firefox",
        "package": "wxt zip && wxt zip -b firefox",
        "postinstall": "wxt prepare",
        "test": "vitest run",
        "lint:types": "vue-tsc --noEmit",
        "lint:code": "eslint --fix .",
        "lint": "pnpm lint:code"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@fileship/ui": "workspace:*",
        "@fontsource-variable/geist": "^5.3.0",
        "@lucide/vue": "^1.55.0",
        "@tailwindcss/vite": "^4.3.3",
        "@wxt-dev/module-vue": "^1.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-vue": "^10.11.1",
        "reka-ui": "^2.11.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "unplugin-vue-components": "^32.1.0",
        "vitest": "^5.0.5",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.12",
        "wxt": "^0.21.4"
    }
}
