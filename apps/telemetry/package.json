{
    "name": "telemetry",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "pnpm db:generate && nuxt build",
        "dev": "pnpm db:generate && pnpm db:deploy && nuxt dev --port 3002",
        "preview": "pnpm db:deploy && node --env-file-if-exists=.env -r ./scripts/fixPrisma.js .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "cleanup": "nuxt cleanup",
        "lint:types": "nuxt typecheck",
        "lint:code": "eslint --fix .",
        "lint": "pnpm lint:code",
        "db:migrate": "prisma migrate dev --create-only",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate --no-hints",
        "db:deploy": "prisma migrate deploy"
    },
    "dependencies": {
        "@fileship/telemetry": "workspace:*",
        "@fileship/ui": "workspace:*",
        "@unovis/ts": "^1.7.1",
        "@unovis/vue": "^1.7.1",
        "consola": "^3.4.2",
        "dayjs": "^1.11.23",
        "defu": "^6.1.7",
        "dotenv": "^18.0.7",
        "filesize": "^11.0.25",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@vueuse/core": "^15.0.0",
        "eslint": "^10.12.0",
        "nuxt": "^4.6.1",
        "prisma": "^7.8.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.12"
    }
}
