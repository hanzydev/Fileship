{
    "name": "fileship",
    "description": "An open-source, self-hosted file and media management platform.",
    "version": "5.4.4",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --filter=dashboard",
        "preinstall": "npx -y only-allow pnpm",
        "lint": "turbo run lint && prettier --write .",
        "lint:types": "turbo run lint:types",
        "check": "pnpm build && pnpm lint && pnpm lint:types",
        "release": "changelogen --release"
    },
    "devDependencies": {
        "changelogen": "^0.6.2",
        "prettier": "^3.9.10",
        "turbo": "^2.11.7"
    },
    "packageManager": "pnpm@11.9.0"
}
