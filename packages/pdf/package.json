{
    "name": "@fileship/pdf",
    "description": "PDF rendering for Fileship with PDFium, run on a worker thread",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "tsdown",
        "lint": "eslint --fix ."
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./worker": "./dist/pdf-worker.mjs",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@fileship/eslint-config": "workspace:*",
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@embedpdf/pdfium": "^2.15.1"
    }
}
